WIdO Prescriptions (Thousands) =
SUM ( fact_wido_observed[prescriptions_thousand] )

WIdO DDD (Thousands) =
SUM ( fact_wido_observed[ddd_thousand] )

WIdO Net Cost (EUR) =
SUM ( fact_wido_observed[net_cost_thousand_eur] ) * 1000

WIdO Cost per Prescription (Weighted EUR) =
DIVIDE ( [WIdO Net Cost (EUR)], [WIdO Prescriptions (Thousands)] * 1000 )

Population (Persons) =
CALCULATE (
    SUM ( fact_population_observed[population_persons] ),
    fact_population_observed[age_label] = "Insgesamt"
)

Population 2025 (Persons) =
CALCULATE (
    [Population (Persons)],
    dim_date[date_key] = "2025"
)

Obesity Prevalence (%) =
SELECTEDVALUE ( fact_obesity_observed[estimate_pct] )

Obesity Prevalence 2023 (%) =
CALCULATE (
    SELECTEDVALUE ( fact_obesity_observed[estimate_pct] ),
    dim_date[date_key] = "2023"
)

Disease Cost (Million EUR) =
CALCULATE (
    SUM ( fact_disease_cost_observed[value] ),
    fact_disease_cost_observed[unit] = "Mill. EUR"
)

Disease Cost - Diabetes 2023 (Million EUR) =
CALCULATE (
    [Disease Cost (Million EUR)],
    dim_date[date_key] = "2023",
    fact_disease_cost_observed[diagnosis_code] = "E10-E14"
)

Scenario Result Status =
CALCULATE (
    SELECTEDVALUE ( scenario_framework[status] ),
    scenario_framework[parameter] = "net_budget_impact"
)

Hero Population (Persons) =
SUM ( fact_population_state_age_sex[population_persons] )

Hero State Share (%) =
DIVIDE (
    [Hero Population (Persons)],
    CALCULATE ( [Hero Population (Persons)], REMOVEFILTERS ( dim_geography ) )
) * 100

Hero State Rank =
RANKX (
    ALLSELECTED ( dim_geography[state_name] ),
    [Hero Population (Persons)],
    , DESC, Dense
)
